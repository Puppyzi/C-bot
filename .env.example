BOT_TOKEN=your_discord_bot_token
CLIENT_ID=your_discord_application_id
# Optional: use guild-only command deployment during development
GUILD_ID=

# AI chat
GOOGLE_API_KEY=your_google_ai_studio_key

# Channel summaries
HUGGINGFACE_API_KEY=your_hugging_face_key

# Vertex AI image generation
PROJECT_ID=your_google_cloud_project_id
LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=C:\\path\\to\\service-account.json

# Presence
BOT_STATUS=online
ACTIVITY_TYPE=PLAYING
ACTIVITY_NAME=Discord

# Comma-separated Discord user IDs; the server owner is always allowed
APPROVED_USER_IDS=

# Optional database path; defaults to database/cultbot.db
# CULTBOT_DB_PATH=C:\\path\\to\\cultbot.db
